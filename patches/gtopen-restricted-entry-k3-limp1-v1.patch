+    use super::*;
+    #[test]
+    fn restricted_save_requires_new_magic_and_explicit_identity() {
+        let cfg: PreflopConfig = serde_json::from_value(serde_json::json!({
+            "positions":["BTN","SB","BB"],"stack":2.0,"posts":[0.0,0.5,1.0],
+            "limp":true,"max_raises":4,"open_raises":[],"raise_mults":[],
+            "add_allin":true,"realization":"balanced","restricted_entry_k3_limp1":true
+        })).unwrap();
+        let eq=Arc::new(EquityTable::build(1));
+        let s=PreflopSolver::new(cfg,eq.clone()).unwrap();
+        let path=std::env::temp_dir().join(format!("gtopen-restricted-save-{}.gtop",std::process::id()));
+        s.save_game(path.to_str().unwrap()).unwrap();
+        let bytes=std::fs::read(&path).unwrap();
+        assert!(bytes.starts_with(MAGIC_RESTRICTED));
+        let loaded=PreflopSolver::load_game(path.to_str().unwrap(),eq.clone()).unwrap();
+        assert!(loaded.cfg.restricted_entry_k3_limp1);
+        assert_eq!(s.arena_len,loaded.arena_len);
+        let mut wrong=bytes.clone(); wrong[10]=b'4'; std::fs::write(&path,&wrong).unwrap();
+        assert!(PreflopSolver::load_game(path.to_str().unwrap(),eq.clone()).is_err());
+        let end=12+bytes[12..].iter().position(|&b|b==b'\n').unwrap();
+        let mut header: serde_json::Value=serde_json::from_slice(&bytes[12..end]).unwrap();
+        header["config"].as_object_mut().unwrap().remove("restricted_entry_k3_limp1");
+        let mut missing=MAGIC_RESTRICTED.to_vec(); missing.extend(serde_json::to_vec(&header).unwrap());
+        missing.extend_from_slice(&bytes[end..]); std::fs::write(&path,&missing).unwrap();
+        assert!(PreflopSolver::load_game(path.to_str().unwrap(),eq).is_err());
+        std::fs::remove_file(path).unwrap();
+    }
+}
